# Copy to backend/.env and fill in. Never commit the real .env file.

# --- generated secrets (see docs/04_API_KEYS_AND_SECRETS.md for how to generate) ---
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
FERNET_KEY=changeme-generate-with-python-cryptography-fernet

# --- local infra (docker-compose defaults, no external account needed) ---
DATABASE_URL=postgresql+asyncpg://drashti:drashti_dev_password@localhost:5432/drashti
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=drashti
MINIO_SECRET_KEY=drashti_dev_password
MINIO_BUCKET=drashti-evidence
MINIO_SECURE=false

# --- app config ---
ENV=development

# When true, the ingestion layer reads from local recorded clips in
# data/spike/plates/ (or a dedicated data/demo_clips/ dir) instead of live
# RTSP, so the full demo runs with zero external dependencies. This is the
# fallback if government feeds on Sept 10-11 use an unexpected codec, an
# auth scheme we haven't seen, or are simply unreachable -- see
# docs/05_ROADMAP_7DAY.md. Built now (Day 1), not on Day 6, on purpose.
DRASHTI_DEMO_MODE=true
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- optional, only needed if you wire up web push (see docs/04) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
